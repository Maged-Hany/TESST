{
  "name": "foody",
  "version": "1.0.0",
  "description": "Foody - Nutrition Tracking, Weekly Meal Planner, and Workout Schedule Platform",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "dev": "vite",
    "start": "concurrently -n api,web -c gray,red \"node server/index.js\" \"vite\"",
    "assets:hero": "python execution/remove_background.py --input .tmp/hero-source.jpg --output public/images/athlete.png",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "python execution/init_db.py",
    "db:reset": "python execution/init_db.py --reset",
    "calculate": "python execution/calculate_targets.py",
    "test:api": "python execution/test_api.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5"
  }
}
